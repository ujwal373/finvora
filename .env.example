# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API.
# Only the PUBLIC keys go here. Never put the service-role / secret key in any VITE_ variable:
# everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Newer projects: "publishable" key (sb_publishable_...). Older projects: the "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local Preview lets you walk the city without a cloud account.
# It is only offered when Supabase is NOT configured. Leave false for public releases.
VITE_ALLOW_LOCAL_PREVIEW=false
